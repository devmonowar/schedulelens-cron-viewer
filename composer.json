{
	"name": "devmonowar/schedulelens-cron-viewer",
	"description": "See all scheduled jobs, catch overdue tasks, run or pause events, and check cron health - lightweight, admin-only, 100% free.",
	"type": "wordpress-plugin",
	"keywords": [
		"cron",
		"cron-manager",
		"cron job manager",
		"scheduler",
		"wp-cron",
		"missed-schedule",
		"scheduled posts",
		"health",
		"wordpress-plugin"
	],
	"homepage": "https://devmonowar.github.io/schedulelens-cron-viewer/",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Monowar Hossain",
			"email": "devmonowar@gmail.com",
			"homepage": "https://devmonowar.github.io/",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/devmonowar/schedulelens-cron-viewer/issues",
		"source": "https://github.com/devmonowar/schedulelens-cron-viewer",
		"forum": "https://wordpress.org/support/plugin/schedulelens-cron-viewer/"
	},
	"require": {
		"php": ">=7.4",
		"composer/installers": "^1.0 || ^2.0"
	},
	"config": {
		"platform": {
			"php": "7.4.33"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"composer/installers": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"stan": "phpstan analyse --memory-limit=2G"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2",
		"php-stubs/wordpress-stubs": "^7.1"
	}
}

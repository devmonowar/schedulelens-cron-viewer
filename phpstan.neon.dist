parameters:
	level: 5
	paths:
		- schedulelens-cron-viewer.php
		- uninstall.php
		- includes
		- admin/views
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	scanFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
	treatPhpDocTypesAsCertain: false
	parallel:
		maximumNumberOfProcesses: 2
